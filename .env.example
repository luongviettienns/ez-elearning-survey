# Cổng máy chủ local
PORT=3000
# Mật khẩu quản trị trên server, ít nhất 12 ký tự
ADMIN_KEY=thay-bang-mat-khau-dai-it-nhat-12-ky-tu
DATA_DIR=./data

# Để trống khi chạy local bằng file JSONL.
# BẮT BUỘC trên Vercel; đặt trực tiếp trong Vercel Environment Variables.
# SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_URL=
# Khóa server sb_secret_... hoặc JWT service_role; không dùng publishable/anon.
SUPABASE_SECRET_KEY=
# Biến cũ chỉ để chuyển đổi: xem docs/ROLLOUT.md trước khi chạy supabase.sql.
SUPABASE_KEY=
